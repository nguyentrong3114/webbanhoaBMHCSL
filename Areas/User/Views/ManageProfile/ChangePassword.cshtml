@{
    ViewData["Title"] = "ChangePassword";
}
<link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet">
<style>
    form {
        padding: 20px;
    }

    form div {
        padding: 20px;
    }

    form div input {
        width: 300px;
        height: 50px;
        border-radius: 10px;
    }

    .changePassword {
        height: 50%;
        width: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .btn-save {
        width: 150px;
        cursor: pointer;
        height: 40px;
    }
</style>
<div class="changePassword">
    <div class="form-2">
        <form action="">
            <div class="curentPassword">
                <input type="text" name="" id="" placeholder="Current Password">
            </div>
            <div class="newPassword">
                <input type="text" name="" id="" placeholder="New Password">
            </div>
            <div class="confirmNewPassword">
                <input type="text" name="" id="" placeholder="Confirm Password">
            </div>
            <div class="btn-save">
                <button class="btn-save">Save</button>
            </div>
        </form>
    </div>
</div>