@{
    ViewData["Title"] = "";
}
<link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet">
<style>
    .content-overview-profile {
        display: flex;
    }

    .right {
        height: 100%;
    }

    .profile-header {
        padding: 20px;
    }

    .profile-info {
        padding: 20px;
    }

    .info-item {
        padding: 10px;
    }
    .btn-save{
        width: 150px;
        cursor: pointer;
        height: 40px;
        border-radius: 30px;
    }

</style>
<link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet">
<div class="content-overview-profile">
    <div class="left">
        <div class="left-atribute">
            <div class="avatar">
                <img src="https://lh3.googleusercontent.com/d/1IBkPMaHKnXHyGn-PBZJN7wfoY4jy0P8k" alt="">
            </div>
            <div class="content">
                <p><strong>Nguyễn Trọng</strong></p>
            </div>
            <div class="btn">
                <button>
                    Upload Image
                </button>
            </div>
            <div class="vip-progress">
                <p>VIP 8</p>
                <input type="range" min="0" max="100" value="100" id="experience-range">
                <p>VIP 9</p>
            </div>
        </div>
        <div class="Decription">
            <div class="">
                <H1></H1>
            </div>
        </div>
    </div>
    <div class="right">
        <div class="profile-header">
            <h1>Thông tin cá nhân</h1>
        </div>
        <div class="profile-info">
            <div class="info-item">
                <label>ID:</label>
                <span>ARR 199</span>
            </div>
            <div class="info-item">
                <label>Tên Khách Hàng:</label>
                <span>Nguyễn Văn A</span>
            </div>
            <div class="info-item">
                <label>Ngày Tháng Năm Sinh:</label>
                <span>01/01/1990</span>
            </div>
            <div class="info-item">
                <label>Email:</label>
                <span>nguyenvana@example.com</span>
            </div>
            <div class="info-item">
                <label>Số Điện Thoại:</label>
                <span>0123456789</span>
            </div>
            <div class="info-item">
                <label>Địa Chỉ:</label>
                <span>123 Đường ABC, Quận 1, TP.HCM</span>
            </div>
            <div class="info-item">
                <label>Giới Tính</label>
                <span>Nam</span>
            </div>
            <div class="info-item">
                <label>Ngày Đăng Kí</label>
                <span>30/01/2004</span>
            </div>
            <div class="info-item">
                <button class="btn-save">Lưu</button>
            </div>
        </div>
    </div>
</div>