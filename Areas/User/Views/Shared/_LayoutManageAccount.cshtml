<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link href="~/lib/sb-admin-2/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/BMHCSDL.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ManageAccount.css" asp-append-version="true" />
</head>
<style>
    a {
        list-style: none;
        direction: none;
        text-decoration: none;
    }
</style>

<body>
    <div class="home-container">
        <div class="header">
            <div class="logo">
                <h1><a href="/Home/Index">FLOWERS </a></h1>
            </div>
            <div class="navbar">
                <p><a asp-area="" asp-controller="Home" asp-action="Index" class="nav">Home</a></p>
                <p><a asp-area="" asp-controller="Home" asp-action="About" class="nav">About</a></p>
                <div class=" nav dropdown">
                    <p class="dropbtn"><a asp-area="" asp-controller="Home" asp-action="Clothes">Flower</a></p>
                    <ul class="dropdown-menu">
                        <li><a href="#">Hot</a></li>
                        <li><a href="#">Best Seller</a></li>
                        <li><a href="#">Free Ship</a></li>
                    </ul>
                </div>
                <p><a href="/Home/Index" class="nav">Contact</a></p>
                <p><a href="/Home/Index" class="nav">Help</a></p>
            </div>
        </div>
    </div>
    <div class="profile-container">
        <div class="profile-navbar">
            <div class="menu-parent">
                <div class="menu-title">
                    <h3>MENU</h3>
                </div>
                <div class="list-menu" id="list-menu">
                    <a class="btn" asp-area="User" asp-controller="ManageProfile" asp-action="ManageProfile">
                        <i class="fa-solid fa-grip"></i>
                        <p>Overview</p>
                    </a>
                    <a class="btn" asp-area="User" asp-controller="ManageProfile" asp-action="ChangePassword">
                        <i class="fa-solid fa-lock"></i>
                        <p>Password</p>
                    </a>
                    <div class="btn">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <p>History Trade</p>
                    </div>
                    <div class="btn">
                        <i class="fa-solid fa-star"></i>
                        <p>VIP</p>
                    </div>
                    <div class="btn">
                        <i class="fa-solid fa-blog"></i>
                        <p>Blog</p>
                    </div>
                </div>
            </div>
            <hr>
            <div class="menu-parent">
                <div class="menu-title">
                    <h3>SUPPORT</h3>
                </div>
                <div class="list-menu">
                    <div class="btn">
                        <i class="fa-solid fa-gear"></i>
                        <p>Setting</p>
                    </div>
                    <div class="btn">
                        <i class="fa-solid fa-circle-question"></i>
                        <p>Help</p>
                    </div>
                    <div class="btn">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <p>Log Out</p>
                    </div>
                </div>
            </div>
        </div>
        @RenderBody()
    </div>
</body>
<script>
    const range = document.getElementById('experience-range');

    range.addEventListener('input', function () {
        const value = (range.value - range.min) / (range.max - range.min) * 100;
        range.style.background = `linear-gradient(to right, #4caf50 ${value}%, #ddd ${value}%)`;
    });

    const select = document.getElementById('list-menu');
    select.addEventListener('click', function (event) {

        if (event.target.classList.contains('btn') || event.target.closest('.btn')) {

            const items = select.getElementsByClassName('btn');
            for (let item of items) {
                item.classList.remove('active');
            }

            const btn = event.target.closest('.btn');
            if (btn) {
                btn.classList.add('active');
            }
        }
    }); 
</script>

</html>